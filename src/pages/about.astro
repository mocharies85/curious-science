---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Curious Science',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="ABOUT CURIOUS SCIENCE"
    image={{
      src: '~/assets/images/kepler-satellite-orbit.jpg',
      alt: 'Orbital mechanics and cosmos illustration',
    }}
  >
    <Fragment slot="title">
      Illuminating the Hidden Equations of <span class="text-accent dark:text-white highlight">Reality</span>
    </Fragment>

    <Fragment slot="subtitle">
      Curious Science is an independent digital journal dedicated to foundational physics, cosmological anomalies, and the mathematical iron laws of the universe. We bridge the chasm between academic rigor and narrative elegance—without sensationalism, dilution, or compromise.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Our Scientific Horizon"
    stats={[
      { title: 'Core Disciplines', amount: '4' },
      { title: 'In-Depth Monograms', amount: '10+' },
      { title: 'LaTeX-Free Precision', amount: '100%' },
      { title: 'Audience Reach', amount: 'Global' },
    ]}
  />

  <!-- Features3 Widget (Our Pillars) ************** -->

  <Features3
    title="Editorial Pillars"
    subtitle="We deconstruct the universe not through superficial metaphors, but through the mechanical truths governing reality across micro and macro scales."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Quantum & Particle Physics',
        description:
          'From quantum tunneling keeping the Sun alive to the destruction of local realism through Bell’s theorem and vacuum energy.',
        icon: 'tabler:atom',
      },
      {
        title: 'Relativity & Astrophysics',
        description:
          'Investigating gravitational time dilation, Chandrasekhar mass limits, stellar evolution, and orbital dynamics.',
        icon: 'tabler:planet',
      },
      {
        title: 'Biophysics & Earth Extremes',
        description:
          'Deciphering the electrochemical millivolt batteries of consciousness, deep ocean hydrostatic limits, and ancient natural nuclear piles.',
        icon: 'tabler:dna',
      },
    ]}
  />

  <!-- Steps2 Widget (Philosophy) ****************** -->

  <Steps2
    title="Our Principles"
    subtitle="How we approach scientific storytelling and analysis."
    items={[
      {
        title: '1. Truth Over Hype',
        description:
          'We avoid breathless science journalism and clickbait headlines. If an equation has strict boundaries or an anomaly remains unsolved, we state the mathematics plainly.',
      },
      {
        title: '2. Elegant Typography',
        description:
          'Formulas should invite contemplation, not intimidation. We transform dense blackboard notations into readable, clean editorial typography.',
      },
      {
        title: '3. Permanent Curiosity',
        description:
          'The universe owes us neither simplicity nor comfort. We celebrate the unresolved questions that push human thought to its absolute edge.',
      },
    ]}
  />
</Layout>