---
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact - Curious Science',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="EDITORIAL DESK" title="Connect with Us" />

  <ContactUs
    id="form"
    title="Send a Scientific Inquiry"
    subtitle="Whether you have an observation regarding an equation, an editorial errata report, or a cross-disciplinary proposal, our desk reviews all thoughtful correspondence."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Inquiry / Mathematical Observation',
      rows: 5,
    }}
    disclaimer={{
      label:
        'By submitting this inquiry, you agree to our standard academic and privacy guidelines.',
    }}
    description="Editorial inquiries are evaluated within 24 to 48 hours."
  />

  <!-- Features2 Widget (Channels) ************** -->

  <Features2
    title="Direct Correspondence Channels"
    items={[
      {
        title: 'Editorial & Monograms',
        description:
          'Submit essay proposals, theoretical physics dissections, or inquiries regarding our published articles.',
        icon: 'tabler:writing',
      },
      {
        title: 'Scientific Errata',
        description:
          'Empirical precision is non-negotiable. Report formula discrepancies or request formal editorial corrections.',
        icon: 'tabler:math',
      },
      {
        title: 'Syndication & Media',
        description:
          'Inquiries regarding article republication, citation attribution, and academic referencing.',
        icon: 'tabler:world',
      },
      {
        title: 'Desk Email',
        description: 'mocharies85@gmail.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Editorial Hours',
        description: 'Monday – Friday, 09:00 – 17:00 UTC',
        icon: 'tabler:clock',
      },
      {
        title: 'Publication Base',
        description: 'Independent Digital Scientific Journal',
        icon: 'tabler:compass',
      },
    ]}
  />
</Layout>