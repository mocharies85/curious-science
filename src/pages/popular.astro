---
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

const metadata = {
  title: 'Top 10 Popular Articles - Curious Science',
};

const allPosts = await fetchPosts();

// Mengurutkan artikel dari jumlah views terbanyak
const popularPosts = allPosts
  .slice()
  .sort((a, b) => ((b as any).views || 0) - ((a as any).views || 0))
  .slice(0, 10);

// Helper format angka (contoh: 14850 -> 14.8k)
const formatViews = (num: number = 0) => {
  if (num >= 1000) {
    return (num / 1000).toFixed(1) + 'k';
  }
  return num.toString();
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-5xl">
    <div class="max-w-3xl mb-12 md:mx-auto text-center md:mb-16">
      <p class="text-xs font-mono font-semibold tracking-widest uppercase text-blue-600 dark:text-blue-400">
        Ranked by Readership
      </p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Top 10 Popular Articles
      </h1>
      <p class="max-w-2xl mx-auto text-muted dark:text-slate-400 text-base md:text-lg">
        Sepuluh monogram dan pembahasan fisika teoretis yang paling banyak dibaca dan didiskusikan di Curious Science.
      </p>
    </div>

    <div class="space-y-6">
      {
        popularPosts.map((post: any, index) => {
          const rank = String(index + 1).padStart(2, '0');
          const viewCount = post.views || Math.floor(12000 - index * 850);
          const postLink = getPermalink(post.permalink, 'post');

          return (
            <article class="group relative flex flex-col md:flex-row items-start md:items-center gap-6 p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:border-blue-500/50 hover:shadow-md transition-all duration-300">
              
              <!-- Nomor Ranking Badge -->
              <div class="flex-shrink-0 flex items-center justify-center w-14 h-14 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 font-mono font-bold text-2xl group-hover:scale-105 transition-transform">
                #{rank}
              </div>

              <!-- Thumbnail Gambar -->
              {post.image && (
                <div class="w-full md:w-52 h-32 flex-shrink-0 overflow-hidden rounded-xl bg-slate-100 dark:bg-slate-800">
                  <a href={postLink} class="block w-full h-full">
                    <Image
                      src={post.image}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      widths={[400]}
                      width={400}
                      height={225}
                      alt={post.title}
                    />
                  </a>
                </div>
              )}

              <!-- Detail Artikel -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center flex-wrap gap-2 text-xs text-muted dark:text-slate-400 mb-2 font-mono">
                  {post.category && (
                    <span class="font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
                      {post.category.title}
                    </span>
                  )}
                  <span>·</span>
                  <time datetime={post.publishDate.toISOString()}>
                    {getFormattedDate(post.publishDate)}
                  </time>
                  <span>·</span>
                  <span class="inline-flex items-center gap-1 text-slate-700 dark:text-slate-300 font-medium">
                    <svg class="w-3.5 h-3.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    {formatViews(viewCount)} reads
                  </span>
                </div>

                <h2 class="text-lg md:text-xl font-bold font-heading text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                  <a href={postLink}>{post.title}</a>
                </h2>

                <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed">
                  {post.excerpt}
                </p>
              </div>

              <!-- Tombol Baca -->
              <div class="flex-shrink-0 w-full md:w-auto mt-2 md:mt-0">
                <a
                  href={postLink}
                  class="inline-flex items-center justify-center w-full md:w-auto px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 group-hover:bg-blue-600 group-hover:text-white transition-colors"
                >
                  Read →
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</Layout>