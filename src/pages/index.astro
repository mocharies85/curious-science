---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Curious Science — Unraveling the Mysteries of the Universe & Mind',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Explore Articles',
        href: '/blog',
        icon: 'tabler:compass',
      },
      { text: 'Browse Topics', href: '#topics' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1600&q=80',
      alt: 'Deep space cosmic nebula',
    }}
  >
    <Fragment slot="title">
      Where Curiosity Meets the <span class="text-accent dark:text-white highlight">Frontiers of Reality</span>
    </Fragment>

    <Fragment slot="subtitle">
      Deep-dive explorations into cosmic anomalies, quantum paradoxes, extreme biology, and the profound questions reshaping human understanding.
    </Fragment>
  </Hero>

  <!-- Core Topics Grid -->
  <div id="topics">
    <Features2
      title="Explore by Discipline"
      subtitle="Curated dispatches from the bleeding edge of modern scientific inquiry."
      columns={3}
      items={[
        {
          title: 'Cosmos & Astrophysics',
          description:
            'From the mechanics of black holes to the expanding vacuum of dark energy and relativistic cosmology.',
          icon: 'tabler:planet',
          callToAction: {
            text: 'Explore Cosmos →',
            href: '/category/cosmos',
          },
        },
        {
          title: 'Quantum & Fundamental Physics',
          description:
            'Unraveling quantum entanglement, wave-particle duality, particle accelerators, and the fabric of spacetime.',
          icon: 'tabler:atom',
          callToAction: {
            text: 'Explore Physics →',
            href: '/category/physics',
          },
        },
        {
          title: 'Deep Earth & Abyssal Oceans',
          description:
            'Investigating sub-crustal ecosystems, hydrothermal vents, geodynamics, and untouched subterranean depths.',
          icon: 'tabler:world',
          callToAction: {
            text: 'Explore Earth →',
            href: '/category/earth',
          },
        },
        {
          title: 'Mind, Consciousness & Evolution',
          description:
            'Probing neurological architecture, non-human intelligence, evolutionary anomalies, and biological resilience.',
          icon: 'tabler:dna',
          callToAction: {
            text: 'Explore Mind →',
            href: '/category/mind',
          },
        },
        {
          title: 'Scientific Paradoxes',
          description:
            'Rigorous investigations into unexplained physical anomalies, observational contradictions, and frontier data.',
          icon: 'tabler:sparkles',
          callToAction: {
            text: 'Explore Paradoxes →',
            href: '/category/anomalies',
          },
        },
        {
          title: 'Future Horizons',
          description:
            'Technological singularity, theoretical warp propulsion, bio-synthetic hybridization, and planetary defense.',
          icon: 'tabler:rocket',
          callToAction: {
            text: 'Explore Future →',
            href: '/category/future',
          },
        },
      ]}
    />
  </div>

  <!-- Latest Articles Section (Grid 6 Artikel) -->
  <BlogLatestPosts
    title="Latest Dispatches & Insights"
    information="Read our most recent peer-informed essays, deep dives, and scientific analyses."
    count={6}
  />

  <!-- Newsletter / Readership Call to Action -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Browse All Publications',
        href: '/blog',
        icon: 'tabler:book-2',
      },
    ]}
  >
    <Fragment slot="title">
      Feed Your Scientific Curiosity
    </Fragment>

    <Fragment slot="subtitle">
      Every week, we dissect profound questions across the cosmos, physics, and the living world.
    </Fragment>
  </CallToAction>
</Layout>