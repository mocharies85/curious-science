<!-- Interactive Thematic Ko-fi Floating Widget for Curious Science -->
<div id="kofi-smart-widget" class="fixed bottom-4 right-4 z-40 flex flex-col items-end font-sans">
  
  <!-- Thematic Prompt Card (Muncul Otomatis) -->
  <div
    id="kofi-prompt-card"
    class="hidden mb-3 w-80 max-w-[calc(100vw-2rem)] rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 p-4 shadow-2xl backdrop-blur-md transition-all duration-500"
    role="dialog"
    aria-label="Support Curious Science"
  >
    <!-- Tombol Silang (X) -->
    <button
      id="kofi-dismiss-btn"
      type="button"
      class="absolute top-2.5 right-2.5 rounded-full p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors"
      aria-label="Close donation prompt"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Konten Pesan -->
    <div class="flex items-start gap-3">
      <div class="flex-shrink-0 mt-0.5 rounded-xl bg-blue-500/10 dark:bg-blue-400/10 p-2 text-blue-600 dark:text-blue-400">
        <!-- Ikon Sains / Atom Fisika -->
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="2"></circle>
          <path d="M12 2a10 10 0 0 0-4.9 18.7M12 2a10 10 0 0 1 4.9 18.7"></path>
          <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(30 12 12)"></ellipse>
          <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(-30 12 12)"></ellipse>
        </svg>
      </div>

      <div class="pr-2">
        <span class="text-[10px] font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">Open-Access Science</span>
        <h4 class="text-sm font-semibold text-slate-900 dark:text-white mt-0.5">Fuel Independent Research</h4>
        <p class="mt-1 text-xs leading-relaxed text-slate-600 dark:text-slate-300">
          Curious Science delivers rigorous monographs on theoretical physics and cosmic mechanics with zero paywalls. If our equations fuel your curiosity, consider supporting our editorial desk on Ko-fi.
        </p>

        <!-- Tombol Aksi -->
        <div class="mt-3 flex items-center gap-2">
          <a
            href="https://ko-fi.com/cycrack"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 dark:bg-blue-500 hover:bg-blue-700 dark:hover:bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white shadow transition-all duration-200 hover:scale-105 active:scale-95"
          >
            <span>☕</span>
            <span>Support on Ko-fi</span>
          </a>
          <button
            id="kofi-later-btn"
            type="button"
            class="text-[11px] text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors px-1"
          >
            Maybe later
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Tombol Melayang Kecil (Sticky Trigger) -->
  <button
    id="kofi-mini-trigger"
    type="button"
    class="group flex items-center gap-2 rounded-full border border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-slate-900/90 px-3.5 py-2 shadow-lg backdrop-blur-md transition-all duration-300 hover:scale-105 hover:border-blue-500 hover:shadow-blue-500/20 cursor-pointer"
    title="Support Curious Science on Ko-fi"
  >
    <!-- Dot Berkedip Halus -->
    <span class="relative flex h-2 w-2">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue-500 opacity-75"></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-blue-500"></span>
    </span>
    <span class="text-base leading-none">☕</span>
    <span class="text-xs font-medium text-slate-700 dark:text-slate-200 transition-colors group-hover:text-blue-500 dark:group-hover:text-blue-400">
      Support
    </span>
  </button>
</div>

<!-- Skrip Interaktif Timer & ViewTransitions Safe -->
<script is:inline>
  function setupKofiWidget() {
    const card = document.getElementById("kofi-prompt-card");
    const miniBtn = document.getElementById("kofi-mini-trigger");
    const dismissBtn = document.getElementById("kofi-dismiss-btn");
    const laterBtn = document.getElementById("kofi-later-btn");

    if (!card || !miniBtn) return;

    const COOLDOWN_MS = 3 * 60 * 1000; // Muncul kembali setelah 3 menit jika disilang
    const FIRST_APPEAR_MS = 25 * 1000; // Tampil setelah 25 detik membaca

    let timer = null;

    function showCard() {
      card.classList.remove("hidden");
    }

    function hideCard() {
      card.classList.add("hidden");
      sessionStorage.setItem("kofi_dismissed_until", (Date.now() + COOLDOWN_MS).toString());
      
      clearTimeout(timer);
      timer = setTimeout(() => {
        showCard();
      }, COOLDOWN_MS);
    }

    const dismissedUntil = sessionStorage.getItem("kofi_dismissed_until");
    const now = Date.now();

    if (!dismissedUntil || now > parseInt(dismissedUntil, 10)) {
      timer = setTimeout(() => {
        showCard();
      }, FIRST_APPEAR_MS);
    } else {
      const remainingTime = parseInt(dismissedUntil, 10) - now;
      timer = setTimeout(() => {
        showCard();
      }, remainingTime);
    }

    if (dismissBtn) dismissBtn.onclick = hideCard;
    if (laterBtn) laterBtn.onclick = hideCard;

    miniBtn.onclick = () => {
      if (card.classList.contains("hidden")) {
        showCard();
      } else {
        window.open("https://ko-fi.com/cycrack", "_blank", "noopener,noreferrer");
      }
    };
  }

  setupKofiWidget();
  document.addEventListener("astro:page-load", setupKofiWidget);
</script>